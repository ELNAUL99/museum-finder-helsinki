# Copy to .env and source it before running the backend, or export these directly.

# Enables Claude-powered natural-language search. Without it the app still works,
# falling back to the built-in keyword interpreter.
ANTHROPIC_API_KEY=

# Database (defaults match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/museumfinder
DB_USER=museumfinder
DB_PASSWORD=museumfinder

# Required in any real deployment: openssl rand -base64 48
JWT_SECRET=
